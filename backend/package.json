{
    "name": "horto-web-backend",
    "version": "1.0.0",
    "description": "API do sistema de gestão digital para hortos botânicos",
    "main": "dist/index.js",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "node dist/index.js",
        "migrate": "tsx src/db/migrate.ts",
        "migrate:prod": "node dist/db/migrate.js"
    },
    "license": "ISC",
    "type": "commonjs",
    "engines": {
        "node": ">=26.13.0"
    },
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "jsonwebtoken": "^9.0.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg-promise": "^12.7.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.6",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
