# Variáveis do docker compose. Copie para .env e ajuste (todas são opcionais em dev).

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horto

# Autenticação — em produção, use uma chave longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=troque-esta-chave-secreta
JWT_EXPIRES_IN=8h

# Portas expostas no host
WEB_PORT_HOST=3001
API_PORT_HOST=3002
DB_PORT_HOST=5433
